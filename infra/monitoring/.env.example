# Monitoring stack env
# Copy to .env and fill in values

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Pi-hole (v6 uses password, not API token)
PIHOLE_PASSWORD=  # Your Pi-hole admin password

# TP-Link Router SNMP
# Make sure SNMP is enabled on your TP-Link router
# Usually under Advanced > System Tools > SNMP Settings
ROUTER_IP=192.168.0.1
SNMP_COMMUNITY=public

# LLM Proxy — apps point their base_url here
# Anthropic: http://192.168.0.5:8082/anthropic/v1/messages
# OpenAI:    http://192.168.0.5:8082/openai/v1/chat/completions
# Ollama:    http://192.168.0.5:8082/ollama/api/chat
